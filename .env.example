# Darkforest Web optional public/local-demo environment values.
# Tasks do not auto-load this file. Export only the values you need, and never commit secrets.

# -----------------------------------------------------------------------------
# Browser-visible values
# Every PUBLIC_* value can be exposed in rendered HTML and client bundles.
# The fixture WebSocket endpoint is intentionally fixed to loopback in source.
# -----------------------------------------------------------------------------
# Production metadata only accepts HTTPS. Leave unset for loopback development.
PUBLIC_SITE_URL=https://your-public-origin.example
SHOW_DEV_CONTROLS=1
SEO_INDEXABLE=false
FEEDBACK_URL=

# -----------------------------------------------------------------------------
# The public demo fixes the web and mock listeners to loopback ports 8000 and 8788.
# Changing deployment topology requires an explicit downstream configuration and CSP review.
# -----------------------------------------------------------------------------
# This public client has no production credentials or built-in provider keys.
# If a downstream deployment adds a server-side secret, configure it only in
# that deployment's secret store; do not add its value to this file.
